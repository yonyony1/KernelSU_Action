# KernelSU Action -- build profile
# For Samsung SM-S9380 Android15 6.6 GKI
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/common
KERNEL_SOURCE_BRANCH=android15-6.6
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=S9380-6.6-GKI
ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel-build-2024
CLANG_VERSION=r510928

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 6.6 GKI 开启完整LLVM编译
USE_LLVM=true

# ===================================================================== GCC ==
# USE_LLVM=true，GCC全部关闭
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# 使用原版tiann KernelSU v3.3.0，和你的补丁匹配
KSU_VARIANT=kernelsu
KSU_REF=v3.3.0

# 6.6内核kprobe稳定，selinux_hide_kprobe.c依赖kprobe
KSU_HOOK_MODE=kprobes

# 官方Manager，留空
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# 开启SUSFS，配合三星DEFEX/RKP隐藏
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# 6.6内核原生拥有path_umount，不需要回补
ENABLE_PATH_UMOUNT=false

# 开启额外隐藏，增强三星检测规避
ENABLE_HIDE_STUFF=true

# KPM关闭，当前方案手动打KDP/RKP补丁
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# 额外defconfig配置，后续可追加三星相关开关
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/yonyony1/KernelSU_Action/releases/download/untagged-c9bb7b70be1225386be8/boot.img

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
