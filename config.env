# KernelSU Action -- build profile
# 适配：三星Galaxy S25U (SM-G9910) 6.6.98 内核 | LKM可加载模块模式
# KernelSU版本：官方原版 v3.3.0（最新稳定版）

CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# 三星S25U 6.6.98 GKI内核源码仓库
KERNEL_SOURCE=https://github.com/sungho-moon/s25_gki
# 对应6.6.98版本的内核分支
KERNEL_SOURCE_BRANCH=6.6.98
# 国行S25U默认内核配置文件
KERNEL_CONFIG=vendor/g9910_chn_defconfig
# 三星6.6内核镜像文件名
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 可选：自定义内核名称标识，留空自动派生
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 只编译LKM内核模块（关键开关：仅输出ksu.ko，不编译完整内核）
BUILD_MODULE_ONLY=true

# 额外编译参数，6.6内核使用LLD链接器
EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# 6.6内核适配稳定版clang工具链
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 6.6内核完整支持LLVM全链路编译
USE_LLVM=true

# ===================================================================== GCC ==
# 6.6新内核无需GCC工具链，全部关闭
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# 官方原版KernelSU
KSU_VARIANT=kernelsu
# 最新稳定版 v3.3.0，原生支持6.6 GKI内核
KSU_REF=v3.3.0

# 6.6内核原生支持kprobes，使用kprobes钩子模式
KSU_HOOK_MODE=kprobes

# 自定义管理器签名校验，留空使用官方KernelSU管理器
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# Root隐藏插件，需要隐藏Root时设为true
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-6.6

# ========================================================== Extra patches ===
# 6.6内核原生支持path_umount，无需回补
ENABLE_PATH_UMOUNT=false

# 额外隐藏指纹，配合SUSFS使用
ENABLE_HIDE_STUFF=true

# KPM内核补丁模块支持
ENABLE_KPM=false

# ================================================================ Kconfig ===
# 开启KPROBES配置（KernelSU必需）
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# 关闭三星内核强制模块签名（必须项，否则insmod加载失败）
EXTRA_DEFCONFIG="CONFIG_MODULE_SIG=n CONFIG_MODULE_SIG_FORCE=n CONFIG_MODULE_SIG_ALL=n"

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false

# 不打包boot.img，仅输出内核模块文件
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
