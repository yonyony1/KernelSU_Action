# KernelSU Action -- build profile
# 设备：三星 Galaxy S25 Ultra 国行 (SM‑S9380 / pa3q)
# 内核：6.6.152 GKI source‑kernel.tar.gz r21
# 模式：仅编译 LKM 可加载模块 (insmod 加载，无需修改 boot.img)
# Root方案：官方 KernelSU v3.3.0 + SUSFS + hide_stuff

CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# yml已经在线下载tar包，下面两个变量仅占位，不会git clone
KERNEL_SOURCE=https://github.com/sungho-moon/s25_gki
KERNEL_SOURCE_BRANCH=main

# ✅修正：使用源码包内真实defconfig路径
KERNEL_CONFIG=s25_samsung_lkm_common_v2_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 仅编译内核模块，不编译完整内核镜像
BUILD_MODULE_ONLY=true

EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 6.6 内核全链路 LLVM 编译
USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu
KSU_REF=v3.3.0
KSU_HOOK_MODE=kprobes

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
# ✅修正：6.6 LTS专用分支
SUSFS_BRANCH=gki-android15-6.6

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# 关闭三星内核强制模块签名校验（insmod 加载必需）
EXTRA_DEFCONFIG="CONFIG_MODULE_SIG=n CONFIG_MODULE_SIG_FORCE=n CONFIG_MODULE_SIG_ALL=n"

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
# KernelSU Action -- build profile
# 设备：三星 Galaxy S25 Ultra 国行 (SM‑S9380 / pa3q)
# 内核：6.6.152 GKI source‑kernel.tar.gz r21
# 模式：仅编译 LKM 可加载模块 (insmod 加载，无需修改 boot.img)
# Root方案：官方 KernelSU v3.3.0 + SUSFS + hide_stuff

CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# yml已经在线下载tar包，下面两个变量仅占位，不会git clone
KERNEL_SOURCE=https://github.com/sungho-moon/s25_gki
KERNEL_SOURCE_BRANCH=main

# ✅修正：使用源码包内真实defconfig路径
KERNEL_CONFIG=configs/r7-6.6.152-r21.config
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 仅编译内核模块，不编译完整内核镜像
BUILD_MODULE_ONLY=true

EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 6.6 内核全链路 LLVM 编译
USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu
KSU_REF=v3.3.0
KSU_HOOK_MODE=kprobes

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
# ✅修正：6.6 LTS专用分支
SUSFS_BRANCH=kernel-6.6-lts

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# 关闭三星内核强制模块签名校验（insmod 加载必需）
EXTRA_DEFCONFIG="CONFIG_MODULE_SIG=n CONFIG_MODULE_SIG_FORCE=n CONFIG_MODULE_SIG_ALL=n"

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
